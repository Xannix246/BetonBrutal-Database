model SteamUser {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  steamId  String   @unique
  username String
  items    String[]
  replays  String[]
}

model WorkshopItem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  steamId     String   @unique
  creator     String
  creatorId   String
  createDate  DateTime @default(now())
  ratingUp    Int      @default(0)
  ratingDown  Int      @default(0)
  description String?
  previewUrl  String
  previews    String[]
  filename    String? // if map was uploaded
  tags        String[] // for prefabs or other future items
  isHidden    Boolean? @default(false)

  linkedCollection String?     @unique
  collection       Collection? @relation(fields: [linkedCollection], references: [id], onDelete: Cascade) // if tag - collection
  tierData         TierData?
}

model LeaderboardEntry {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  place    Int
  mapId    String
  steamId  String
  username String
  score    Int
  replayId String?
  date     DateTime?
  banned   Boolean   @default(false)

  @@unique([mapId, steamId])
}

model Leaderboard {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  mapId        String   @unique
  enteries     String[] //LeaderboardEntry id's
  playersCount Int?
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  mapId     String
  userId    String
  data      String
  createdAt DateTime @default(now())
}

enum Labels {
  grapples
  wallruns
  trampolines
  ice
  nerveControl
  xxl
  coyotes
  pfp
  gimicky
  puzzle
  moving
  showcase
  overall
  nonLinear
  chockepoints
  shitpost
  bath
  random
  precision
}

enum TierStatus {
  accepted
  denied
  pending
}

model TierEntry {
  id     String     @id @default(auto()) @map("_id") @db.ObjectId
  tier   Int
  userId String
  tierId String
  mapId  String
  status TierStatus @default(pending)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tierData TierData @relation(fields: [tierId], references: [id], onDelete: Cascade)

  @@unique([userId, tierId])
}

model TierData {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  modTier    Float    @default(-1)
  avgTier    Float    @default(-1)
  qalTier    Float    @default(0) @ignore
  labels     Labels[]
  isPossible Boolean?

  mapId       String       @unique
  map         WorkshopItem @relation(fields: [mapId], references: [steamId], onDelete: Cascade)
  tierEntries TierEntry[]
}

type ItemData {
  id          String
  title       String
  creator     String
  originality Float
  aesthetic   Float
  fun         Float
  theme       Float
  totalScore  Float
  userVotes   String[]
}

model EventData {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  start       DateTime
  end         DateTime
  isVisible   Boolean
  imageUrl    String
  themeWords  String[]
  items       ItemData[]
}
